{
  "name": "deepseek-harness-server",
  "version": "0.1.0",
  "description": "OAuth-scoped business connector, Runtime Gateway, and browser preferences for DeepSeek Harness",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiworkskills/deepseek-harness-server.git"
  },
  "bugs": {
    "url": "https://github.com/aiworkskills/deepseek-harness-server/issues"
  },
  "homepage": "https://github.com/aiworkskills/deepseek-harness-server#readme",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "example": "pnpm --filter @dshserver/dsh-integration build && pnpm --filter @dshserver/example-local-smoke start",
    "release:check": "node scripts/check-release.mjs",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
